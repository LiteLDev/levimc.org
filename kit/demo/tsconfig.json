{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "kit/**/*.ts",
    "kit/**/*.tsx",
    "showcase",
    "app",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-lip",
    "dist-single",
    ".kit",
    "app/dist",
    "app/.kit"
  ]
}
