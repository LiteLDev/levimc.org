# levimc-kit, copied from ../kit by `pnpm install` (scripts/fetch-kit.mjs)
/kit/

# the registry cache (src/server/registry.ts; the Actions cache in CI)
/.cache/

# the /api/ folder prerender.mjs writes (dist/ is ignored at the root)
/dist-api/

# the pages in the other languages prerender.mjs writes: dist-locales/<lang>/ is the site's /<lang>/mods/ folder
/dist-locales/
