// Based on kit/tsconfig.template.json. levimc.org is a plain Vite app, so only the kit's React
// components (and the few kit modules the app imports) are type-checked — not the docs engine.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": ["kit/components", "src", "*.ts"],
  "exclude": ["node_modules", "dist", ".kit"]
}
