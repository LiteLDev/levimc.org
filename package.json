{
  "name": "levimc-org",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .kit/ssr && node prerender.mjs",
    "preview": "node kit/scripts/serve-pages.mjs dist --base / --port 4173",
    "typecheck": "tsc --noEmit",
    "linkcheck": "node kit/scripts/linkcheck.mjs dist --base / --site-origin https://levimc.org",
    "smoke": "node scripts/smoke.mjs --url http://127.0.0.1:4173/"
  },
  "dependencies": {
    "lucide-react": "0.562.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
